<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainingHelper.FreeExerciseDb.GUI.ViewModels"
             x:Class="TrainingHelper.FreeExerciseDb.GUI.Views.ConfigureExerciseView"
             x:DataType="vm:ConfigureExerciseViewModel">

    <Grid ColumnDefinitions="8*,2*" >
        <Interaction.Behaviors>
            <EventTriggerBehavior EventName="Loaded">
                <InvokeCommandAction Command="{Binding LoadedCommand}" />
            </EventTriggerBehavior>
        </Interaction.Behaviors>
        <ItemsControl Grid.Column="0" ItemsSource="{Binding Images}" >
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="8" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#222222"
                            Padding="6"
                            CornerRadius="6">
                        <Image Source="{Binding}"
                               Stretch="Uniform"
                               Width="100"
                               Height="100">
                            <ToolTip.Tip>
                                <Border Background="#222222"
                                        Padding="6"
                                        CornerRadius="6">
                                    <Image Source="{Binding}"
                                           MaxWidth="400"
                                           MaxHeight="400"
                                           Stretch="Uniform" />
                                </Border>
                            </ToolTip.Tip>
                            <ToolTip.Placement>Right</ToolTip.Placement>
                            <ToolTip.ShowDelay>300</ToolTip.ShowDelay>
                        </Image>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding ExerciseDetails}"  SelectedItem="{Binding SelectedExercsie}"/>
    </Grid>
</UserControl>
