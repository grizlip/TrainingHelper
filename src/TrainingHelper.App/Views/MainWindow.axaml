<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TrainingHelper.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TrainingHelper.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="TrainingHelper.App">
    <Window.Resources>
        <ResourceDictionary >
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key='Light'>
                    <SolidColorBrush x:Key='PathBrush'>Black</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key='Dark'>
                    <SolidColorBrush x:Key='PathBrush'>Yellow</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <vm:SecondsToTimeConverter x:Key="SecondsToTimeConverter" />
            <DataTemplate x:Key="image">
                <Image Source="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Photo}" />
            </DataTemplate>
            <DataTemplate x:Key="path">
                <Path Stretch="Uniform" Width="100" Height="120" Fill="{DynamicResource PathBrush}">
                    <Interaction.Behaviors>
                        <DataTriggerBehavior
                            Binding="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Work}"
                            ComparisonCondition="Equal" Value="false">
                            <ChangePropertyAction PropertyName="Data"
                                                  Value="{StaticResource Geometry_Break}" />
                        </DataTriggerBehavior>
                        <DataTriggerBehavior
                            Binding="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Work}"
                            ComparisonCondition="Equal" Value="true">
                            <ChangePropertyAction PropertyName="Data"
                                                  Value="{StaticResource Geometry_Work}" />
                        </DataTriggerBehavior>
                    </Interaction.Behaviors>
                </Path>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <TabControl Margin="5">
        <TabItem Header="Workout">
            <Grid RowDefinitions="Auto,Auto, *">
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <Button DockPanel.Dock="Left" Command="{Binding StartCountdownCommand}">Start</Button>
                    <Button DockPanel.Dock="Left" Command="{Binding PauseResumeCountdownCommand}">Pause/Resume</Button>
                    <Button DockPanel.Dock="Left" Command="{Binding StopCountdownCommand}">Stop</Button>
                </DockPanel>
                <StackPanel Grid.Row="1">
                    <StackPanel Orientation="Horizontal">
                        <Label VerticalAlignment="Center">Current round: </Label>
                        <Label VerticalAlignment="Center" Content="{Binding CurrentRound}" />
                        <Label IsVisible="{Binding IsCountdownInProgress}">
                            <Interaction.Behaviors>
                                <DataTrigger Binding="{Binding Work}" Value="True">
                                    <ChangePropertyAction PropertyName="Content" Value="Work" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Work}" Value="False">
                                    <ChangePropertyAction PropertyName="Content" Value="Break" />
                                </DataTrigger>
                            </Interaction.Behaviors>
                        </Label>
                    </StackPanel>
                    <ProgressBar Margin="0 10" Height="20"
                                 Minimum="0" Maximum="{Binding TotalSeconds}"
                                 Value="{Binding SecondsPassed}"
                                 ShowProgressText="True">
                        <ProgressBar.ProgressTextFormat>
                            <MultiBinding Converter="{StaticResource SecondsToTimeConverter}">
                                <Binding Path="SecondsPassed" />
                                <Binding Path="TotalSeconds" />
                            </MultiBinding>
                        </ProgressBar.ProgressTextFormat>
                    </ProgressBar>
                </StackPanel>
                <ContentControl Grid.Row="2">
                    <Interaction.Behaviors>
                        <DataTriggerBehavior Binding="{Binding ShowImages}" ComparisonCondition="Equal"
                                             Value="false">
                            <ChangePropertyAction PropertyName="ContentTemplate"
                                                  Value="{StaticResource path}" />
                        </DataTriggerBehavior>
                        <DataTriggerBehavior Binding="{Binding ShowImages}" ComparisonCondition="Equal"
                                             Value="true">
                            <ChangePropertyAction PropertyName="ContentTemplate"
                                                  Value="{StaticResource image}" />
                        </DataTriggerBehavior>
                    </Interaction.Behaviors>
                </ContentControl>
            </Grid>
        </TabItem>
        <TabItem Header="Plan">
            <StackPanel>
                <StackPanel.Styles>
                    <Style Selector="TimePicker, NumericUpDown">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="IsEnabled" Value="{Binding !IsCountdownInProgress}" />
                    </Style>
                    <Style Selector="TimePicker">
                        <Setter Property="ClockIdentifier" Value="24HourClock" />
                        <Setter Property="UseSeconds" Value="True" />
                    </Style>
                    <Style Selector="Label">
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </StackPanel.Styles>
                <Label>Interval: </Label>
                <TimePicker SelectedTime="{Binding Interval}"/>
                <Label>Break: </Label>
                <TimePicker SelectedTime="{Binding Break}" />
                <Label>Rounds count: </Label>
                <NumericUpDown Value="{Binding RoundsCount}"
                               HorizontalAlignment="Left"
                               VerticalContentAlignment="Center"
                               Minimum="1" Maximum="200"
                               Increment="1"
                               ShowButtonSpinner="False"/>
            </StackPanel>
        </TabItem>
        <TabItem Header="Settings">
            <StackPanel>
                <Label VerticalAlignment="Center">Audio device: </Label>
                <ComboBox Margin="5" MinWidth="220" HorizontalAlignment="Left"
                          ItemsSource="{Binding AudioDevices}"
                          SelectedItem="{Binding SelectedAudioDevice}"
                          IsEnabled="{Binding HasAudioDevices}" />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>