<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainingHelper.App.ViewModels"
             x:Class="TrainingHelper.App.Views.RoundView"
             x:DataType="vm:RoundViewModel">
    <StackPanel>
        <StackPanel.Styles>
            <Style Selector="TimePicker">
                <Setter Property="Margin" Value="5" />
                <Setter Property="ClockIdentifier" Value="24HourClock" />
                <Setter Property="UseSeconds" Value="True" />
            </Style>
            <Style Selector="Label">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </StackPanel.Styles>
        <Label>Round number: </Label>
        <Label Content="{Binding RoundNumber}" />
        <Label>Interval: </Label>
        <TimePicker SelectedTime="{Binding Interval}" />
        <Label>Break: </Label>
        <TimePicker SelectedTime="{Binding Break}" />
    </StackPanel>
</UserControl>
