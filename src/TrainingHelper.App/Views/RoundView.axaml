<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:TrainingHelper.App.ViewModels"
             x:Class="TrainingHelper.App.Views.RoundView"
             x:DataType="vm:RoundViewModel">
    <Grid ColumnDefinitions="*,Auto">
        <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="*,*,*">
            <Grid.Styles>
                <Style Selector="TimePicker">
                    <Setter Property="Margin" Value="5" />
                    <Setter Property="ClockIdentifier" Value="24HourClock" />
                    <Setter Property="UseSeconds" Value="True" />
                </Style>
                <Style Selector="Label">
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Grid.Styles>
            <Label Grid.Row="0" Grid.Column="0">Round number: </Label>
            <Label Grid.Row="0" Grid.Column="1" Content="{Binding RoundNumber}"/>
            <Label Grid.Row="1" Grid.Column="0">Interval: </Label>
            <TimePicker Grid.Row="1" Grid.Column="1" SelectedTime="{Binding Interval}" />
            <Label Grid.Row="2" Grid.Column="0">Break: </Label>
            <TimePicker Grid.Row="2" Grid.Column="1" SelectedTime="{Binding Break}" />
        </Grid>
    </Grid>
</UserControl>
